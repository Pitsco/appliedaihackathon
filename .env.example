# Copy this file to .env and fill in the two secrets. Never commit .env.

# --- Clio Manage (read-only) -------------------------------------------------
# Option A: paste an access token you already exchanged by hand.
CLIO_ACCESS_TOKEN=

# Option B: let the app run the OAuth flow. Create an app at developers.clio.com,
# add http://127.0.0.1:3000/clio/callback as a redirect URI, then open /clio/login.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:3000/clio/callback

# US accounts use app.clio.com. EU: eu.app.clio.com, CA: ca.app.clio.com, AU: au.app.clio.com
CLIO_BASE_URL=https://app.clio.com

# Which matter to digest. Leave CLIO_MATTER_ID empty to find it by name.
CLIO_MATTER_ID=
CLIO_MATTER_QUERY=Sapini

# --- AI digestion ------------------------------------------------------------
# Set ONE of these two keys. The app uses whichever is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bulk reading uses the small model, judgement uses the larger one. Leave these empty for the
# defaults: claude-haiku-4-5-20251001 and claude-sonnet-5-5 on Anthropic, gpt-4.1-mini and gpt-4.1 on OpenAI.
EXTRACT_MODEL=
SYNTH_MODEL=
# Lower this to 1 or 2 if your API key is rate limited.
AI_CONCURRENCY=4

# --- App ---------------------------------------------------------------------
PORT=3000
# Provider links expire after this many days unless the attorney picks otherwise.
SHARE_LINK_DAYS=14

# --- Tuning (optional) ---------------------------------------------------------
# Size of the fact ledger sent to the brief writer, in characters. Raise on a higher API tier.
# LEDGER_CHARS=64000
# Pages read per document before the rest is reported as unread.
# MAX_DOC_PAGES=200
# Override or add prices, USD per million tokens [input, output], matched by model-name prefix.
# MODEL_PRICES={"claude-sonnet-5-5":[2,10]}
